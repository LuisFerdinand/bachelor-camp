{
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",

  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,

  "files.autoSave": "onFocusChange",

  "vs-code-prettier-eslint.prettierLast": true,

 "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "tabnine.disable": true,

  "files.watcherExclude": {
  "**/node_modules/**": true,
  "**/.next/**": true,
  "**/.turbo/**": true,
  "**/dist/**": true,
  "**/build/**": true,
  "**/.git/**": true
},
  "search.exclude": {
  "**/node_modules/**": true,
  "**/.next/**": true,
  "**/.turbo/**": true,
  "**/dist/**": true,
  "**/build/**": true,
  "**/.git/**": true
},
   "typescript.tsserver.maxTsServerMemory": 1024,
     "typescript.tsserver.useSeparateSyntaxServer": false,

  "tailwindCSS.emmetCompletions": false,
  "tailwindCSS.validate": false,

  "typescript.disableAutomaticTypeAcquisition": true,
    "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": false,
   "telemetry.telemetryLevel": "off",
   "eslint.run": "onSave",
"eslint.quiet": true,
"typescript.preferences.includePackageJsonAutoImports": "off",
"javascript.validate.enable": false
}
